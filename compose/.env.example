# Digin's settings for docker-compose.yaml. No secret goes here: secrets are files in ./secrets
# (make-secrets.sh). Every setting, its default and its control: Digin's configuration reference.

# Which release. The FIPS image is the same tag with -fips (then set DIGIN_FIPS=require below).
DIGIN_RELEASE=v0.44.0
# Where the app's plain-HTTP port is published, for a reverse proxy on this host that ends TLS.
DIGIN_BIND=127.0.0.1:3000

# Required: the https address people use. Your proxy forwards it to DIGIN_BIND.
DIGIN_PUBLIC_URL=https://digin.example.com

# Sign-in: any OpenID Connect provider (Keycloak, Entra ID, Okta, Authentik, Google Workspace...).
# Register the redirect URL <DIGIN_PUBLIC_URL>/auth/callback; the client secret goes in
# secrets/oidc_client_secret.
OIDC_ISSUER=https://login.example.com/realms/work
OIDC_CLIENT_ID=digin
OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_NAME=Single sign-on
# DIGIN_REQUIRE_VERIFIED_EMAIL=1

# The proxies whose X-Forwarded-For is believed (addresses or CIDRs), or none. Unset: any private address.
# DIGIN_TRUSTED_PROXIES=172.16.0.0/12

# ClamAV: start with `docker compose --profile scan up -d`, then:
# DIGIN_SCAN=clamd://clamav:3310

# The FIPS image (DIGIN_RELEASE=v0.44.0-fips): refuse to start outside FIPS 140-3 mode.
# DIGIN_FIPS=require

# Hold the deployment to the secure baseline: any departure stops the server. See what it would refuse
# first with: docker compose run --rm --no-deps digin check
# DIGIN_PROFILE=fisma-moderate

# Calls: your own STUN/TURN servers as JSON, or [] for none. Unset: Cloudflare's public STUN server.
# DIGIN_ICE_SERVERS=[]
# Where bots may send (model servers), or none. Unset: any public host.
# DIGIN_BOTS_ALLOWED_HOSTS=none
# DIGIN_SESSION_MAX=12h
# DIGIN_SESSION_IDLE=30m
# DIGIN_MAX_UPLOAD_MB=25

# Docker Desktop (macOS, Windows) cannot give a secret file to uid 65532; make-secrets.sh makes them
# world-readable there instead, and Digin must be told to accept that (a departure `digin check` names).
# DIGIN_SECRET_FILE_CHECK=off

TZ=UTC

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Digin Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publicUrl"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "fips": {
          "type": "boolean"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "publicUrl": {
      "type": "string",
      "description": "The https address people use (DIGIN_PUBLIC_URL)",
      "pattern": "^(https://[^/]+)?$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "signIn": {
      "type": "object",
      "properties": {
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(https://.*)?$"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "cloudflareTeamDomain": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "google": {
          "type": "object",
          "properties": {
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "signup": {
          "type": "string",
          "enum": [
            "",
            "open",
            "invite"
          ]
        },
        "requireVerifiedEmail": {
          "type": "boolean"
        },
        "adminGroup": {
          "type": "string"
        },
        "auditorGroup": {
          "type": "string"
        },
        "groupsClaim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "",
            "fisma-moderate"
          ]
        },
        "trustedProxies": {
          "type": "string"
        },
        "allowedHosts": {
          "type": "string"
        },
        "maxUploadMB": {
          "type": "integer",
          "minimum": 1
        },
        "iceServers": {
          "type": "string"
        },
        "botsAllowedHosts": {
          "type": "string"
        },
        "sessionMax": {
          "type": "string"
        },
        "sessionIdle": {
          "type": "string"
        },
        "contactEmail": {
          "type": "string"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "secretFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*_FILE$"
          },
          "key": {
            "type": "string",
            "pattern": "^[-._a-zA-Z0-9]+$"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "env",
          "key"
        ]
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "filesKey": {
          "type": "string"
        },
        "dbOwnerPassword": {
          "type": "string"
        },
        "dbServerPassword": {
          "type": "string"
        },
        "dbSystemPassword": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ownerUser": {
          "type": "string",
          "minLength": 1
        },
        "logins": {
          "type": "string",
          "enum": [
            "separate",
            "owner"
          ]
        },
        "serverUser": {
          "type": "string",
          "minLength": 1
        },
        "systemUser": {
          "type": "string",
          "minLength": 1
        },
        "requireTLS": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "migrate": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 20
        },
        "sharedBuffers": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?)?$"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "sslMode": {
          "type": "string",
          "enum": [
            "disable",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "caSecret": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "shutdownDelaySeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "appTLS": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "probes": {
      "type": "object",
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "minAvailable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "egress": {
          "type": "object",
          "properties": {
            "https": {
              "type": "boolean"
            },
            "extra": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "clamav": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "privateMirror": {
          "type": "string",
          "pattern": "^([^:/]+(:[0-9]+)?)?$"
        },
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?)?$"
            },
            "storageClass": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "retainDays": {
          "type": "integer",
          "minimum": 1
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([EPTGMK]i?)?$"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    }
  }
}
